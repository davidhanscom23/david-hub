# Copy to /workspace/david-comfyui/config.env and adjust only if needed.

# Leave blank to auto-detect common RunPod template locations.
COMFYUI_DIR=
COMFY_PYTHON=

# Current official RunPod ComfyUI template port.
COMFY_PORT=8188

# Persistent paths.
COMFY_LOG=/workspace/comfy.log
COMFY_PID_FILE=/workspace/comfy.pid
WATCHDOG_LOG=/workspace/watchdog.log
WATCHDOG_PID_FILE=/workspace/watchdog.pid
RUNPOD_API_KEY_FILE=/workspace/.runpod_api_key

# Idle stop settings (seconds).
AUTO_STOP_ENABLED=1
IDLE_LIMIT=900
CHECK_INTERVAL=60
STARTUP_GRACE=300
API_FAILURE_RETRY=30
