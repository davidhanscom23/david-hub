# Supabase (required for production auth + cloud persistence)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Without Supabase URL/key, the app runs in local demo mode
# (email-free login, browser localStorage persistence).

# Optional AI for /api/calculator/regimen (OpenAI-compatible)
# If unset, the calculator uses the deterministic rules engine.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# AI_API_KEY=   # alias for OPENAI_API_KEY
