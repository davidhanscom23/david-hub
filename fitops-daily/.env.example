# Supabase Auth — required so friends can create accounts on any device.
# Without these, Create account still works but only on that browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Auth tips (Supabase dashboard → Authentication):
# - Enable Email provider
# - For a small private invite, you can disable "Confirm email"
# - Site URL + redirect: https://YOUR-DOMAIN/auth/callback

# Optional AI for /api/calculator/regimen (OpenAI-compatible)
# If unset, the calculator uses the deterministic rules engine.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# AI_API_KEY=   # alias for OPENAI_API_KEY
