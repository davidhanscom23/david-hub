# Supabase — required for real multi-user auth + cloud sync across devices.
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional server-only key (seeds/admin). Never ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# After setting URL/key, run in SQL Editor:
#   supabase/migrations/001_schema.sql
#   supabase/migrations/002_user_app_state.sql
# Auth → Email on; Confirm email off for easy private invites;
# Redirect: http://localhost:3000/auth/callback

# Optional AI for /api/calculator/regimen (OpenAI-compatible)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# AI_API_KEY=   # alias for OPENAI_API_KEY
